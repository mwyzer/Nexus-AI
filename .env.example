# =============================================================================
# Nexus AI — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# =============================================================================
# Database
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=nexusai
DB_PASSWORD=change-me-in-production
DB_NAME=nexusai
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
ASYNC_DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# =============================================================================
# JWT Authentication
# Generate with: openssl rand -base64 64
# =============================================================================
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# AI / LLM
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=
# Defaults to a fully local stack via Ollama (no API key required).
# Set LLM_PROVIDER=openai + LLM_MODEL=gpt-4o (with a real OPENAI_API_KEY) to use OpenAI instead.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# Default embedding model is bge-m3 (MIT-licensed, multilingual, 1024-dim), served via Ollama.
EMBEDDING_MODEL=bge-m3

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434

# =============================================================================
# Service URLs
# =============================================================================
AI_BACKEND_URL=http://localhost:8000
AI_BACKEND_API_URL=http://localhost:8000/api/v1

# =============================================================================
# Frontend (Next.js)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_APP_NAME=Nexus AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Gateway (NestJS)
# =============================================================================
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# AI Backend (FastAPI)
# =============================================================================
AI_BACKEND_PORT=8000
AI_BACKEND_HOST=0.0.0.0

# =============================================================================
# Celery
# =============================================================================
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# =============================================================================
# Security
# =============================================================================
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=text
